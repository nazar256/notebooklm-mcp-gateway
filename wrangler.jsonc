{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notebooklm-mcp-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-03",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  },
  "kv_namespaces": [
    { "binding": "NOTEBOOKLM_SESSION_KV", "id": "__NOTEBOOKLM_SESSION_KV_ID__" }
  ],
  "triggers": {
    // Keep-alive ping every 3 hours so Google cookie rotations accumulate in
    // the KV session jar even while MCP clients are idle.
    "crons": ["15 */3 * * *"]
  },
  "vars": {
    "OAUTH_ISSUER": "https://notebooklm-mcp-gateway.xyofn8h7t.workers.dev",
    "MCP_RESOURCE": "https://notebooklm-mcp-gateway.xyofn8h7t.workers.dev/mcp",
    "MCP_AUDIENCE": "https://notebooklm-mcp-gateway.xyofn8h7t.workers.dev/mcp",
    "ACCESS_TOKEN_TTL_SECONDS": "3600",
    "AUTH_CODE_TTL_SECONDS": "300",
    "CONNECTOR_TTL_MAX_DAYS": "365"
  }
}
